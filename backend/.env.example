# Configuración de Base de Datos PostgreSQL
# Copia este archivo a .env y pon tus credenciales reales de PostgreSQL
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/examendev

# Puerto del servidor Backend
PORT=3000

# Clave secreta para firmar los tokens JWT de sesión
JWT_SECRET=examendev_clave_secreta_super_segura_2026

# Cuenta de administrador compartida del equipo: se crea (o se actualiza) automáticamente al arrancar el backend.
# Si el email ya existe como usuario normal, se le asciende a admin y se le pone esta contraseña.
# La contraseña debe tener al menos 8 caracteres. Nunca subas el .env real a git.
ADMIN_NICK=Administrador
ADMIN_EMAIL=admin@examendev.local
ADMIN_PASSWORD=cambia_esta_contraseña
